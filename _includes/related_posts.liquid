{% assign reading = page | reading_recommendations: site.posts, site.related_blog_posts.max_related %}
{% if reading.previous or reading.next or reading.posts.size > 0 %}
  <section class="post-related" aria-labelledby="related-reading">
    <p class="eyebrow">Continue reading</p>
    <h2 id="related-reading">Related articles</h2>
    {% if reading.previous or reading.next %}
      <nav class="post-series-nav" aria-label="{{ reading.series | escape }} series">
        {% if reading.previous %}
          <a href="{{ reading.previous.url | relative_url }}" rel="prev">
            <span class="post-series-nav__label">← Previous in series</span>
            <span>{{ reading.previous.title | escape }}</span>
          </a>
        {% endif %}
        {% if reading.next %}
          <a href="{{ reading.next.url | relative_url }}" rel="next">
            <span class="post-series-nav__label">Next in series →</span>
            <span>{{ reading.next.title | escape }}</span>
          </a>
        {% endif %}
      </nav>
    {% endif %}
    {% if reading.posts.size > 0 %}
      <ul class="post-related__list">
        {% for post in reading.posts %}
          <li><a href="{{ post.url | relative_url }}">{{ post.title | remove_first: '[Paper Review] ' | escape }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>
{% endif %}
{% if site.newsletter.enabled and site.footer_fixed %}
  <p class="mb-2" style="margin-top: 1.5rem !important">Subscribe to be notified of future articles:</p>
  {% include newsletter.liquid left=true %}
{% endif %}
