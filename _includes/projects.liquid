<div class="col project-card-wrap">
  <article class="project-card">
    <a class="project-card__main" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% if project.img %}
        <div class="project-card__media">
          {% include figure.liquid loading="lazy" path=project.img sizes="(min-width: 768px) 340px, 92vw" alt=project.title class="project-card__image" %}
        </div>
      {% endif %}
      <div class="project-card__body">
        <p class="project-card__eyebrow">Research project</p>
        {% assign project_heading = include.heading_level | default: 2 %}
        <h{{ project_heading }} class="project-card__title">{{ project.title }}</h{{ project_heading }}>
        <p class="project-card__description">{{ project.description }}</p>
        <span class="project-card__read">View project <span aria-hidden="true">→</span></span>
      </div>
    </a>
    {% if project.github %}
      <a class="project-card__repo" href="{{ project.github }}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ project.title }} code repository">
        <i class="fa-brands fa-github" aria-hidden="true"></i> Code
        {% if project.github_stars %}<span id="{{ project.github_stars }}-stars"></span>{% endif %}
      </a>
    {% endif %}
  </article>
</div>
