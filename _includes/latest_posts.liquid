{% if site.posts.size > 0 %}
  {% assign latest_posts_limit = page.latest_posts.limit | default: site.posts.size %}
  <div class="home-writing">
    {% for item in site.posts limit: latest_posts_limit %}
      {% include blog/archive_row.liquid document=item heading_level=3 show_category=true %}
    {% endfor %}
  </div>
{% else %}
  <p>No posts so far.</p>
{% endif %}
