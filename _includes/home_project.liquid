{% assign project = include.project %}
<article class="home-project-row">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="home-project-row__link">
    {% if project.img %}
      <div class="home-project-row__image">
        {% include figure.liquid loading="lazy" path=project.img sizes="84px" alt="" %}
      </div>
    {% endif %}
    <div class="home-project-row__body">
      <h3>{{ project.title }} <span aria-hidden="true">↗</span></h3>
      <p>{{ project.description }}</p>
    </div>
  </a>
</article>
