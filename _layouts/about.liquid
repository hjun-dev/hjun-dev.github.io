---
layout: default
---
<div class="home-page journal-shell">
  <header class="home-hero">
    <div class="home-hero__copy">
      <p class="eyebrow">Aerospace · Control · Learning</p>
      <h1>{{ site.title }}</h1>
      <p class="home-hero__role">{{ page.subtitle }}</p>
      <p class="home-hero__statement">Researching how optimization, control, and learning can make autonomous aerospace systems safer and more capable.</p>
      <div class="home-hero__links">
        <a class="home-hero__primary" href="{{ '/cv/' | relative_url }}">View CV <span aria-hidden="true">→</span></a>
        <a href="{{ '/blog/' | relative_url }}">Read research notes</a>
      </div>
    </div>
    {% if page.profile and page.profile.image %}
      <div class="home-hero__portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid loading="eager" path=profile_image_path class="home-hero__image" avoid_scaling=true alt=site.title cache_bust=true %}
        <p>Inha University<br>Incheon, South Korea</p>
      </div>
    {% endif %}
  </header>

  <article class="home-content">
    <div class="home-content__intro clearfix">{{ content }}</div>

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-module">
        <div class="section-heading"><h2><a href="{{ '/news/' | relative_url }}">News</a></h2></div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-module" aria-labelledby="home-writing-title">
        <div class="section-heading">
          <h2 id="home-writing-title">Latest posts</h2>
          <a class="text-link" href="{{ '/blog/' | relative_url }}">Browse all writing <span aria-hidden="true">→</span></a>
        </div>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-module">
        <div class="section-heading"><h2><a href="{{ '/publications/' | relative_url }}">Selected publications</a></h2></div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.social %}
      <section class="home-module" aria-labelledby="home-contact-title">
        <div class="section-heading"><h2 id="home-contact-title">Contact</h2></div>
        <div class="home-contact">
          <div class="home-contact__details">
            <a href="mailto:{{ page.contact_email }}">{{ page.contact_email }}</a>
            <p>{{ page.contact_address }}</p>
          </div>
          <div class="contact-icons">{% include social.liquid %}</div>
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
