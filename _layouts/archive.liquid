---
layout: default
---
{% assign sorted_documents = '' | split: ',' %}
{% if page.documents %}
  {% assign sorted_documents = page.documents | sort: 'date' | reverse %}
{% elsif page.type == 'categories' and site.categories[page.title] %}
  {% assign sorted_documents = site.categories[page.title] | sort: 'date' | reverse %}
{% endif %}
{% assign is_topic_archive = false %}
{% if page.type == 'categories' or page.type == 'tags' %}
  {% assign is_topic_archive = true %}
{% endif %}
{% assign archive_title = page.title %}
{% assign planned_documents = '' | split: ',' %}
{% if page.type == 'categories' %}
  {% assign planned_documents = site.planned | where: 'primary_category', page.title | sort: 'plan_order' %}
  {% assign archive_title = site.data.blog_category_labels[page.title] | default: page.title %}
{% elsif page.type == 'tags' %}
  {% assign featured_tag = site.data.blog_featured_tags | where: 'key', page.title | first %}
  {% if featured_tag %}
    {% assign archive_title = featured_tag.label %}
  {% endif %}
{% endif %}

<div class="post{% if is_topic_archive %} blog-archive-page{% endif %}">
  {% if is_topic_archive %}
    <header class="blog-archive-header">
      <a class="blog-archive-header__back" href="{{ '/blog/' | relative_url }}">← All writing</a>
      <p class="eyebrow">
        {% if page.type == 'categories' %}Primary field{% else %}Specific topic{% endif %}
      </p>
      <div class="blog-archive-header__title-row">
        <h1>
          {% if page.type == 'tags' %}#{% endif -%}
          {{- archive_title }}
        </h1>
        <span>
          {%- if sorted_documents.size > 0 -%}{{ sorted_documents.size }} published{%- endif -%}
          {%- if planned_documents.size > 0 -%}
            {%- if sorted_documents.size > 0 %} · {% endif -%}
            {{ planned_documents.size }} planned
          {%- endif -%}
        </span>
      </div>
    </header>
  {% else %}
    <header class="post-header">
      {% if page.type == 'year' %}
        <h1 class="post-title"><i class="fa-solid fa-calendar fa-sm"></i> {{ page.date | date: '%Y' }}</h1>
        <p class="post-description">an archive of {{ page.collection_name }} from this year</p>
      {% elsif page.type == 'tags' %}
        <h1 class="post-title"><i class="fa-solid fa-hashtag fa-sm"></i> {{ page.title }}</h1>
        <p class="post-description">an archive of {{ page.collection_name }} with this tag</p>
      {% endif %}
    </header>
  {% endif %}

  {% if is_topic_archive %}
    <section class="blog-category-archive" aria-label="Posts in {{ page.title }}">
      {% if sorted_documents.size > 0 %}
        <div class="blog-archive-subheading">
          <h2>Published articles</h2>
          <p class="eyebrow">Newest first</p>
        </div>
        <div class="blog-archive-list">
          {% for document in sorted_documents %}
            {% include blog/archive_row.liquid document=document %}
          {% endfor %}
        </div>
      {% endif %}
      {% if planned_documents.size > 0 %}
        <div class="blog-archive-subheading blog-archive-subheading--planned">
          <h2>Planned notes</h2>
          <p class="eyebrow">In preparation</p>
        </div>
        <div class="blog-archive-list blog-archive-list--planned">
          {% for document in planned_documents %}
            {% include blog/archive_row.liquid document=document planned=true %}
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% else %}
    <article class="archive">
      <div class="table-responsive">
        <table class="table table-sm table-borderless">
          {% for document in sorted_documents %}
            <tr>
              <th scope="row">{{ document.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if document.redirect == blank %}
                  <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
                {% elsif document.redirect contains '://' %}
                  <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
                {% else %}
                  <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
    </article>
  {% endif %}
</div>
