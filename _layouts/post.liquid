---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign word_count = content | number_of_words %}
{% assign reading_time = word_count | divided_by: 200 %}
{% if reading_time < 1 %}
  {% assign reading_time = 1 %}
{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post post-reading">
  <header class="post-header post-reading__header">
    <p class="eyebrow">{% if page.tags contains 'paper review' %}Paper review{% else %}Research article{% endif %}</p>
    <h1 class="post-title">{{ page.title | remove_first: '[Paper Review] ' }}</h1>
    {% if page.description %}
      <p class="post-reading__dek">{{ page.description }}</p>
    {% endif %}

    <div class="post-meta-row">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%B %-d, %Y' }}</time>
      {% if word_count > 100 %}
        <span aria-hidden="true">·</span>
        <span>{{ reading_time }} min read</span>
      {% endif %}
      {% if page.author %}
        <span aria-hidden="true">·</span>
        <span>By {{ page.author }}</span>
      {% endif %}
      {% if page.last_updated %}
        <span aria-hidden="true">·</span>
        <span>Updated {{ page.last_updated | date: '%B %-d, %Y' }}</span>
      {% endif %}
      {% if page.meta %}
        <span aria-hidden="true">·</span>
        <span>{{ page.meta }}</span>
      {% endif %}
    </div>

    <div class="post-taxonomy" aria-label="Article topics">
      {% for category in page.categories %}
        {% assign category_label = site.data.blog_category_labels[category] | default: category %}
        <a class="post-category" href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">{{ category_label }}</a>
      {% endfor %}
      {% for tag in page.tags limit: 3 %}
        {% if site.tags[tag] %}
          <a class="post-tag" href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">#{{ tag }}</a>
        {% else %}
          <span class="post-tag">#{{ tag }}</span>
        {% endif %}
      {% endfor %}
      <a class="post-year" href="{{ year | prepend: '/blog/' | append: '/' | relative_url }}">{{ year }}</a>
    </div>

    {% if page.toc and page.toc.sidebar %}
      <details class="post-toc-mobile">
        <summary>On this page</summary>
        <div class="post-toc-mobile__content">{% toc %}</div>
      </details>
    {% endif %}
  </header>

  <div class="post-reading-layout {% if page.toc and page.toc.sidebar %}post-reading-layout--with-toc post-reading-layout--toc-{{ page.toc.sidebar }}{% endif %}">
    {% if page.toc and page.toc.sidebar and page.toc.sidebar != 'right' %}
      <aside class="post-toc-desktop" aria-label="Table of contents">
        <nav id="toc-sidebar" class="sticky-top"></nav>
      </aside>
    {% endif %}

    <div class="post-reading__main">
      <article class="post-content">
        {% if page.toc and page.toc.beginning %}
          <div id="table-of-contents">
            {% toc %}
          </div>
          <hr>
        {% endif %}
        <div id="markdown-content">
          {{ content }}
        </div>
      </article>

      {% if page.citation %}
        {% include citation.liquid %}
      {% endif %}

      {% if page.related_publications %}
        <h2>References</h2>
        <div class="publications">
          {% bibliography --group_by none --cited_in_order %}
        </div>
      {% endif %}

      {% if word_count > 100 and site.related_blog_posts and site.related_blog_posts.enabled %}
        {% if page.related_posts == null or page.related_posts %}
          {% include related_posts.liquid %}
        {% endif %}
      {% endif %}

      {% if site.disqus_shortname and page.disqus_comments %}
        {% include disqus.liquid %}
      {% endif %}
      {% if site.giscus and page.giscus_comments %}
        {% include giscus.liquid %}
      {% endif %}
    </div>

    {% if page.toc and page.toc.sidebar == 'right' %}
      <aside class="post-toc-desktop" aria-label="Table of contents">
        <nav id="toc-sidebar" class="sticky-top"></nav>
      </aside>
    {% endif %}
  </div>
</div>
